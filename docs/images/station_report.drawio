        <mxCell id="n7" value="&lt;b&gt;load_station_readings&lt;/b&gt;&lt;br&gt;Load the hourly readings of one&lt;br&gt;station from its Parquet file.&lt;br&gt;in: station_str: str, folder_str:&lt;br&gt;str&lt;br&gt;out: readings_df: pd.DataFrame" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#000000;fillColor=#dae8fc;" vertex="1" parent="1">
