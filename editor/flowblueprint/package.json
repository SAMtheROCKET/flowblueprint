{
  "name": "flowblueprint",
  "displayName": "FlowBlueprint",
  "description": "FlowBlueprint, the Python architect: draw a script, notebook or whole project as a block diagram (draw.io, SVG, HTML or Mermaid) without running it. Experimental preview.",
  "keywords": [
    "python",
    "architecture",
    "diagram",
    "drawio",
    "mermaid",
    "flowchart",
    "jupyter"
  ],
  "version": "0.3.2",
  "toolVersion": "0.3.2a0",
  "publisher": "samtherocket",
  "license": "MIT",
  "icon": "icon.png",
  "homepage": "https://samtherocket.github.io/flowblueprint/",
  "bugs": {
    "url": "https://github.com/SAMtheROCKET/flowblueprint/issues"
  },
  "galleryBanner": {
    "color": "#1c4aa3",
    "theme": "dark"
  },
  "preview": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "flowblueprint.drawFile",
        "title": "FlowBlueprint: Draw architecture of this file"
      },
      {
        "command": "flowblueprint.drawFolder",
        "title": "FlowBlueprint: Draw architecture of this project"
      },
      {
        "command": "flowblueprint.modularizeFile",
        "title": "FlowBlueprint: Run three-tool pipeline of this file"
      },
      {
        "command": "flowblueprint.modularizeFolder",
        "title": "FlowBlueprint: Run three-tool pipeline of this project"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "flowblueprint.drawFile",
          "when": "resourceExtname == .py || resourceExtname == .ipynb",
          "group": "flowblueprint"
        },
        {
          "command": "flowblueprint.drawFolder",
          "when": "explorerResourceIsFolder",
          "group": "flowblueprint"
        },
        {
          "command": "flowblueprint.modularizeFile",
          "when": "resourceExtname == .py || resourceExtname == .ipynb",
          "group": "flowblueprint"
        },
        {
          "command": "flowblueprint.modularizeFolder",
          "when": "explorerResourceIsFolder",
          "group": "flowblueprint"
        }
      ],
      "editor/title/context": [
        {
          "command": "flowblueprint.drawFile",
          "when": "resourceExtname == .py || resourceExtname == .ipynb",
          "group": "flowblueprint"
        }
      ]
    },
    "configuration": {
      "title": "FlowBlueprint",
      "properties": {
        "flowblueprint.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python executable to use. Leave empty to use the interpreter selected in the Python extension (or python on PATH); relative paths resolve from the workspace root."
        },
        "flowblueprint.defaultFormat": {
          "type": "string",
          "enum": [
            "drawio",
            "drawio.png",
            "png",
            "svg",
            "html",
            "md"
          ],
          "enumDescriptions": [
            "Editable draw.io diagram.",
            "PNG with editable draw.io data (requires the PNG extra).",
            "PNG image (requires the PNG extra).",
            "SVG image.",
            "Self-contained web page.",
            "Markdown with a Mermaid flowchart that GitHub and GitLab render."
          ],
          "default": "drawio",
          "description": "Format offered first when drawing."
        },
        "flowblueprint.level": {
          "type": "string",
          "enum": [
            "full",
            "detailed",
            "summary"
          ],
          "enumDescriptions": [
            "An overview, the detailed main flow and one page per function.",
            "The detailed main flow and one page per function.",
            "The overview only: consecutive operations packed into fewer blocks."
          ],
          "default": "full",
          "description": "How much to draw."
        },
        "flowblueprint.view": {
          "type": "string",
          "enum": [
            "pages",
            "reference"
          ],
          "default": "reference",
          "description": "Reference: side-by-side operational flows and two architecture levels. Pages: imports plus individual function pages."
        },
        "flowblueprint.externalizeSql": {
          "type": "boolean",
          "default": false,
          "description": "During modular drafting, extract supported SQL into adjacent sql folders."
        },
        "flowblueprint.workflowPng": {
          "type": "boolean",
          "default": false,
          "description": "Include architecture.drawio.png in modular drafts. Requires the optional PNG renderer."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SAMtheROCKET/flowblueprint"
  },
  "scripts": {
    "test": "node --test test/runner.test.js test/setup.test.js"
  }
}
